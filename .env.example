# Copy to .env.local and fill in values.

# Production / Railway (used when NODE_ENV=production, or when DATABASE_URL_LOCAL is unset)
DATABASE_URL=postgresql://user:pass@host:port/db

# Optional local dev override — Netlify Postgres while `pnpm dev` runs.
# Port: .netlify/state.json → dbConnectionString (often 59258). Then: pnpm db:push && pnpm db:seed
# DATABASE_URL_LOCAL=postgres://localhost:59258/postgres

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public canonical origin for SEO (canonicals, OG URLs, JSON-LD). Production: https://carxq.com
SITE_URL=http://localhost:3000
# Optional: extra trusted auth origins (comma-separated). Dev also allows http://localhost:* .
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3111

# Local dev only — skip email verification so you can sign in immediately after register.
AUTH_SKIP_EMAIL_VERIFICATION=true

# iPay88 does not accept localhost callback URLs. For payment testing locally:
#   1. Run: ngrok http 3000
#   2. Paste the HTTPS URL below (e.g. https://abc123.ngrok-free.app)
#   3. Register that URL with iPay88 support as Response/Backend URL (or use test merchant)
# DEV_TUNNEL_URL=https://your-subdomain.ngrok-free.app

IPAY88_MERCHANT_CODE=
IPAY88_MERCHANT_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=cs@xqholidays.com.my

# Honda N-Box OKU guide video — MP4 path (/video/...) or YouTube embed URL
# VITE_OKU_NBOX_VIDEO_URL=/video/honda-n-box-oku-guide.mp4

# Google Analytics 4 — public measurement ID (safe to expose; baked at build).
# Production: G-B3DQJJH0SR (property "XQ Car" / stream "XQ Car Web").
VITE_GA_MEASUREMENT_ID=

# Langkawi_Preference affiliate tracking (external Refferq-style network,
# separate from the in-house /admin/affiliates system).
# Client-side tracker script injection — public key only, safe to expose.
VITE_AFFILIATE_TRACKING_BASE_URL=
VITE_AFFILIATE_TRACKING_PUBLIC_KEY=

# Server-side conversion webhook — server-only key, never expose to the browser.
AFFILIATE_TRACKING_BASE_URL=
AFFILIATE_TRACKING_PUBLIC_KEY=
