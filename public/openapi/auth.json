{
  "openapi": "3.1.0",
  "info": {
    "title": "XQCar Auth API",
    "version": "1.0.0",
    "description": "Session and OAuth discovery endpoints for XQCar (Better Auth). See /auth.md for agent registration."
  },
  "servers": [
    {
      "url": "https://carxq.com/api/auth"
    }
  ],
  "paths": {
    "/sign-in/email": {
      "post": {
        "summary": "Sign in with email and password",
        "tags": ["auth"]
      }
    },
    "/sign-up/email": {
      "post": {
        "summary": "Create account with email and password",
        "tags": ["auth"]
      }
    },
    "/sign-in/social/google": {
      "get": {
        "summary": "Sign in with Google OAuth",
        "tags": ["auth"]
      }
    },
    "/session": {
      "get": {
        "summary": "Get current session",
        "tags": ["auth"]
      }
    },
    "/sign-out": {
      "post": {
        "summary": "Sign out and revoke session",
        "tags": ["auth"]
      }
    }
  }
}
